# Pick ONE way to switch on AI marking (leave both empty for demo mode).

# Free: OpenRouter key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: models to try, in order (all free)
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Paid: Anthropic key (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: progress saving
SUPABASE_URL=
# Optional server-side key for auth; if blank, the service-role key is used server-side.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
